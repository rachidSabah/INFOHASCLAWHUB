generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("New Chat")
  model        String    @default("gemini-2.5-pro")
  systemPrompt String?
  isFavorite   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  agentId        String?
  role           String // "user", "assistant", "system"
  content        String
  attachments    String? // JSON array of file references
  metadata       String? // JSON for extra info (model, tokens, etc.)
  toolCalls      String? // JSON array of tool calls
  edited         Boolean      @default(false)
  parentId       String? // For conversation branching
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique // Memory key/topic
  content   String // Memory content/summary
  source    String // Source conversation ID or "manual"
  embedding String? // JSON array of embedding vector
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String?
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String
  systemPrompt String
  avatar       String? // Icon/Emoji representation
  skills       String? // JSON array of skill names/IDs
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  content     String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  content    String
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  content    String
  embedding  String?
  index      Int
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([documentId])
}

// === NEW MODELS FOR 16 FEATURE ENHANCEMENTS ===

// Feature 1: Multi-Agent Orchestration
model AgentPipeline {
  id             String   @id @default(cuid())
  name           String
  description    String?
  steps          String // JSON: { agentId, order, approvalRequired, inputMapping, outputMapping }[]
  status         String   @default("draft") // "draft" | "running" | "completed" | "failed" | "paused"
  currentStep    Int      @default(0)
  results        String? // JSON: { step, output, status, duration }[]
  parallelGroups String? // JSON: [[0,1], [2]] - which steps run in parallel
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Feature 2: Autonomous Coding Loop
model CodingSession {
  id            String   @id @default(cuid())
  title         String
  workspacePath String
  task          String // The coding task description
  status        String   @default("idle") // "idle" | "planning" | "coding" | "testing" | "fixing" | "committed" | "failed"
  approvalMode  String   @default("suggest") // "auto" | "suggest" | "ask"
  iterations    Int      @default(0)
  maxIterations Int      @default(10)
  plan          String? // JSON: { steps: string[] }
  checkpoints   String? // JSON: { id, timestamp, commitHash, description }[]
  diffLog       String? // JSON: { timestamp, file, diff }[]
  testResults   String? // JSON: { passed, failed, output }[]
  result        String? // Final result summary
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Feature 3: Multi-Model Router
model ModelRoute {
  id           String   @id @default(cuid())
  name         String
  taskType     String // "code" | "analysis" | "creative" | "quick" | "reasoning" | "embedding"
  modelId      String // The model to route to
  priority     Int      @default(0) // Higher = preferred
  fallbackIds  String   @default("[]") // JSON: string[] of fallback model IDs
  costPerToken Float? // Cost tracking
  avgLatency   Float? // Average response time in ms
  successRate  Float? // 0-1 success rate
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Feature 4: Codebase Intelligence
model CodeIndex {
  id          String   @id @default(cuid())
  projectPath String
  filePath    String
  symbolName  String
  symbolType  String // "function" | "class" | "variable" | "import" | "export"
  lineStart   Int
  lineEnd     Int?
  content     String? // Snippet
  embedding   String? // JSON vector
  updatedAt   DateTime @updatedAt
}

model SecurityVulnerability {
  id         String   @id @default(cuid())
  filePath   String
  line       Int
  severity   String // "critical" | "high" | "medium" | "low" | "info"
  ruleId     String // e.g., "SQL_INJECTION", "EXPOSED_SECRET"
  message    String
  suggestion String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Feature 6: Multi-Platform Comms Hub
model BotConnection {
  id              String    @id @default(cuid())
  platform        String // "whatsapp" | "telegram" | "discord" | "slack"
  name            String
  token           String? // Bot token for Telegram/Discord/Slack
  isConnected     Boolean   @default(false)
  config          String? // JSON: platform-specific config
  botEnabled      Boolean   @default(true)
  connectedNumber String?
  personality     String? // JSON: { tone, style, rules } - channel-specific personality
  lastActivity    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Feature 7: Visual UI Builder
model UIBuilderProject {
  id            String   @id @default(cuid())
  name          String
  description   String?
  framework     String   @default("react") // "react" | "vue" | "html"
  components    String   @default("[]") // JSON: { id, type, props, children, styles }[]
  generatedCode String?
  previewUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Feature 8: Database Studio
model DatabaseConnection {
  id               String   @id @default(cuid())
  name             String
  type             String // "sqlite" | "postgresql" | "mysql" | "mongodb"
  connectionString String
  schemaSnapshot   String? // JSON: last known schema
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Feature 9: Deploy Pipeline
model DeployEnvironment {
  id          String    @id @default(cuid())
  name        String // "dev" | "staging" | "production"
  projectPath String
  type        String // "docker" | "serverless" | "vps" | "static"
  config      String // JSON: environment-specific config
  lastDeploy  DateTime?
  deployCount Int       @default(0)
  status      String    @default("idle") // "idle" | "deploying" | "running" | "failed"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Feature 10: Security Vault
model SecurityAuditLog {
  id        String   @id @default(cuid())
  agentId   String?
  action    String // What was done
  resource  String? // What was accessed
  reasoning String? // Why it was done
  risk      String   @default("low") // "low" | "medium" | "high" | "critical"
  metadata  String? // JSON: additional context
  createdAt DateTime @default(now())
}

model ExposedSecret {
  id          String   @id @default(cuid())
  filePath    String
  line        Int
  secretType  String // "api_key" | "password" | "token" | "private_key" | "connection_string"
  maskedValue String // Show first/last 2 chars only
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature 11: Analytics
model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String // "chat" | "agent_run" | "model_call" | "deploy" | "code_gen"
  model      String?
  agentId    String?
  tokensUsed Int?
  cost       Float?
  duration   Float? // ms
  success    Boolean?
  metadata   String? // JSON
  createdAt  DateTime @default(now())
}

// Feature 12: Plugin Marketplace
model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  author      String
  version     String
  category    String // "integration" | "tool" | "agent" | "theme" | "utility"
  manifest    String // JSON: plugin manifest
  isEnabled   Boolean  @default(false)
  isInstalled Boolean  @default(false)
  rating      Float    @default(0)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature 15: Git Intelligence
model GitAnalysis {
  id          String   @id @default(cuid())
  projectPath String
  commitHash  String
  analysis    String // JSON: { summary, risk, suggestions }
  type        String // "commit" | "pr" | "conflict" | "review"
  createdAt   DateTime @default(now())
}

// ============================================================
// NEXT-GEN ENHANCEMENT MODELS
// ============================================================

// P0-1: Universal Context Memory
model ContextMemory {
  id            String   @id @default(cuid())
  type          String // "episodic" | "semantic" | "procedural" | "project" | "agent" | "session"
  category      String // "conversation" | "code" | "workflow" | "preference" | "error" | "success" | "research"
  content       String
  summary       String? // Compressed/summarized version
  embedding     String? // JSON vector for semantic retrieval
  sourceId      String? // Origin: conversationId, agentId, sessionId, etc.
  sourceType    String? // "conversation" | "agent" | "session" | "manual"
  projectId     String? // Project association
  agentId       String? // Agent association
  tags          String   @default("[]") // JSON: string[]
  priority      Int      @default(0) // Higher = more important
  accessCount   Int      @default(0) // How many times retrieved
  relevanceScore Float? // Computed relevance
  expiresAt     DateTime? // Optional TTL for aging
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([projectId])
  @@index([agentId])
  @@index([priority])
}

model MemoryLink {
  id           String   @id @default(cuid())
  sourceId     String // ContextMemory id
  targetId     String // ContextMemory id
  relationType String // "continuation" | "reference" | "contradiction" | "refinement" | "derived"
  strength     Float   @default(1.0) // 0-1 link strength
  createdAt    DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
}

// P0-2: Cron Scheduling + Always-On Agents
model CronTask {
  id            String    @id @default(cuid())
  name          String
  description   String?
  cronExpr      String // e.g. "*/5 * * * *"
  taskType      String // "agent_run" | "repo_monitor" | "health_check" | "auto_deploy" | "issue_resolve" | "custom"
  agentId       String?
  config        String // JSON: task-specific config
  status        String    @default("active") // "active" | "paused" | "disabled" | "error"
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastResult    String? // JSON: { success, output, duration }
  runCount      Int       @default(0)
  failCount     Int       @default(0)
  retryPolicy   String    @default("{}") // JSON: { maxRetries, backoffMs }
  dependencies  String    @default("[]") // JSON: task IDs that must complete first
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([taskType])
}

model AgentWorker {
  id            String    @id @default(cuid())
  name          String
  agentId       String // Reference to Agent
  status        String    @default("idle") // "idle" | "running" | "waiting" | "error" | "stopped"
  currentTask   String? // Description of current task
  pid           Int? // Process ID if running
  lastHeartbeat DateTime?
  totalTasks    Int       @default(0)
  successCount  Int       @default(0)
  errorCount    Int       @default(0)
  config        String    @default("{}") // JSON: worker config
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// P1-1: Self-Improving Agents
model AgentExperience {
  id             String   @id @default(cuid())
  agentId        String
  taskType       String // "code_gen" | "debug" | "review" | "deploy" | "research" | "general"
  prompt         String // The prompt that was used
  strategy       String // Which strategy/model was chosen
  outcome        String // "success" | "partial" | "failure"
  score          Float // 0-1 quality score
  duration       Float? // ms
  tokensUsed     Int?
  resultSnippet  String? // First 500 chars of result
  learnings      String? // JSON: extracted patterns
  improvedPrompt String? // Optimized prompt based on this experience
  createdAt      DateTime @default(now())

  @@index([agentId])
  @@index([taskType])
  @@index([outcome])
  @@index([score])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  taskType    String
  agentRole   String?
  template    String
  version     Int      @default(1)
  score       Float    @default(0)
  usageCount  Int      @default(0)
  successRate Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskType])
  @@index([agentRole])
}

// P1-2: Research Mode + Citations
model ResearchSession {
  id            String   @id @default(cuid())
  query         String
  status        String   @default("searching") // "searching" | "analyzing" | "synthesizing" | "completed" | "failed"
  sources       String   @default("[]") // JSON: { url, title, snippet, credibility, type }[]
  citations     String   @default("[]") // JSON: { id, sourceId, text, relevance }[]
  findings      String? // Markdown synthesis
  confidence    Float? // 0-1 overall confidence
  depth         String   @default("standard") // "quick" | "standard" | "deep"
  model         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Citation {
  id              String   @id @default(cuid())
  researchId      String
  sourceUrl       String?
  sourceTitle     String
  sourceType      String // "web" | "code" | "doc" | "paper" | "repo"
  snippet         String
  relevanceScore  Float    @default(0)
  credibility     Float    @default(0)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([researchId])
  @@index([sourceType])
}

// P1-3: Issue → Deploy Pipeline
model IssuePipeline {
  id            String    @id @default(cuid())
  issueUrl      String? // GitHub issue URL
  issueTitle    String
  issueBody     String?
  repoUrl       String?
  status        String    @default("planning") // "planning" | "coding" | "testing" | "reviewing" | "pr_created" | "deployed" | "failed"
  plan          String? // JSON: { steps }
  branchName    String?
  prUrl         String?
  prNumber      Int?
  deployUrl     String?
  testResults   String? // JSON
  reviewNotes   String?
  iterations    Int       @default(0)
  maxIterations Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// P2-1: Live App Sandbox
model Sandbox {
  id           String    @id @default(cuid())
  name         String
  framework    String    @default("nextjs") // "nextjs" | "react" | "html" | "vue"
  status       String    @default("creating") // "creating" | "running" | "stopped" | "error"
  port         Int?
  containerId  String?
  previewUrl   String?
  files        String    @default("{}") // JSON: { path: content }
  envVars      String    @default("{}") // JSON: { key: value }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// P2-2: MCP Hub
model MCPRegistry {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  version      String
  author       String
  transport    String // "stdio" | "http" | "websocket"
  endpoint     String? // URL for remote servers
  capabilities String   @default("[]") // JSON: string[]
  authType     String? // "none" | "api_key" | "oauth"
  authConfig   String? // JSON: auth details
  isEnabled    Boolean  @default(false)
  isVerified   Boolean  @default(false)
  rating       Float    @default(0)
  installs     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isEnabled])
}

// P2-3: Hybrid Local ↔ Cloud Router
model ProviderScore {
  id              String   @id @default(cuid())
  providerName    String
  modelId         String
  taskType        String // "code" | "analysis" | "creative" | "reasoning" | "embedding" | "chat"
  avgLatency      Float    @default(0) // ms
  avgTokensPerSec Float    @default(0)
  successRate     Float    @default(0) // 0-1
  costPer1kTokens Float    @default(0)
  contextLength   Int      @default(0)
  qualityScore    Float    @default(0) // 0-1 from evaluations
  privacyLevel    String   @default("cloud") // "local" | "hybrid" | "cloud"
  lastEvaluated   DateTime @default(now())
  sampleSize      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerName, modelId, taskType])
  @@index([taskType])
  @@index([providerName])
}

// P3-1: Verified Plugin Marketplace V2
model VerifiedPlugin {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  author         String
  version        String
  category       String // "integration" | "tool" | "agent" | "theme" | "utility" | "mcp"
  manifest       String // JSON: full manifest
  signature      String? // Cryptographic signature
  checksum       String? // Content hash for verification
  permissions    String   @default("[]") // JSON: requested permissions
  sandboxLevel   String   @default("restricted") // "full" | "restricted" | "minimal"
  isEnabled      Boolean  @default(false)
  isInstalled    Boolean  @default(false)
  isVerified     Boolean  @default(false)
  securityScan   String? // JSON: { passed, issues[] }
  rating         Float    @default(0)
  installs       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isVerified])
}

// P3-2: Real-Time Collaboration
model CollabSession {
  id          String   @id @default(cuid())
  name        String
  hostId      String // User ID of session host
  peers       String   @default("[]") // JSON: { id, name, cursor, color }[]
  status      String   @default("active") // "active" | "ended"
  sharedAgent String? // Agent ID shared in session
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// P3-4: Compliance Engine
model AuditLog {
  id          String   @id @default(cuid())
  actor       String // User/agent who performed action
  action      String // What was done
  resource    String // What was accessed
  result      String // "success" | "denied" | "error"
  risk        String   @default("low") // "low" | "medium" | "high" | "critical"
  details     String? // JSON: additional context
  ipAddress   String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([risk])
  @@index([createdAt])
}

model CompliancePolicy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  ruleType    String // "rbac" | "data_access" | "secret_scan" | "gdpr" | "soc2" | "custom"
  config      String // JSON: rule configuration
  severity    String   @default("medium") // "low" | "medium" | "high" | "critical"
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ruleType])
  @@index([isEnabled])
}

// Feature: Artifacts
model Artifact {
  id         String           @id @default(cuid())
  title      String
  type       String
  content    String           @default("")
  metadata   String?
  version    Int              @default(1)
  shareToken String?          @unique
  isPublic   Boolean          @default(false)
  viewCount  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  versions   ArtifactVersion[]
}

model ArtifactVersion {
  id        String   @id @default(cuid())
  artifactId String
  version   Int
  content   String
  changeLog String?
  createdAt DateTime @default(now())
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
}

// Feature: Workspaces
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature: Kanban Boards
model KanbanBoard {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  columns   KanbanColumn[]
}

model KanbanColumn {
  id        String      @id @default(cuid())
  boardId   String
  name      String
  color     String
  order     Int
  createdAt DateTime    @default(now())
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]

  @@index([boardId])
}

model KanbanCard {
  id          String       @id @default(cuid())
  columnId    String
  title       String
  description String?
  priority    String?
  labels      String? // JSON: string[]
  status      String?
  subtasks    String? // JSON: { title: string; done: boolean }[]
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}

// ============================================================
// RUFLO-PARITY MODELS — Swarm, SONA, Federation, Encryption,
// AIDefence, CostTracker, GoalPlanner, KnowledgeGraph, Workers,
// Verification
// ============================================================

// R1: Swarm Coordination (Queen-led, mesh, hierarchical topologies)
model Swarm {
  id          String   @id @default(cuid())
  name        String
  description String?
  topology    String   @default("hierarchical") // "hierarchical" | "mesh" | "ring" | "star" | "custom"
  consensus   String   @default("raft") // "raft" | "byzantine" | "gossip" | "paxos"
  queenAgentId String? // Lead agent in hierarchical topology
  agents      String   @default("[]") // JSON: { agentId, role, status }[]
  maxAgents   Int      @default(10)
  status      String   @default("idle") // "idle" | "forming" | "active" | "disbanding" | "error"
  taskQueue   String   @default("[]") // JSON: { task, assignedTo, priority, status }[]
  consensusLog String  @default("[]") // JSON: { round, proposal, votes, decision }[]
  config      String   @default("{}") // JSON: topology-specific config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([topology])
}

// R2: SONA Neural Pattern (Self-Learning)
model SONAPattern {
  id           String   @id @default(cuid())
  patternType  String // "trajectory" | "reasoning" | "strategy" | "feedback" | "optimization"
  agentId      String?
  taskType     String
  inputContext String // JSON: context that triggered this pattern
  action       String // What the agent did
  outcome      String // "success" | "partial" | "failure"
  score        Float   @default(0) // 0-1 effectiveness
  neuralWeights String @default("{}") // JSON: learned weight adjustments
  reasoning    String? // Why this approach was chosen
  adaptations  String  @default("[]") // JSON: list of adaptations made
  usageCount   Int     @default(0)
  successCount Int     @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patternType])
  @@index([agentId])
  @@index([taskType])
  @@index([score])
}

// R2b: Reasoning Bank
model ReasoningEntry {
  id           String   @id @default(cuid())
  agentId      String?
  taskType     String
  question     String // The question/problem
  reasoning    String // Chain-of-thought reasoning
  conclusion   String // Final answer/decision
  confidence   Float   @default(0) // 0-1
  model        String? // Which model produced this
  validated    Boolean  @default(false) // Has been validated by outcome
  tags         String   @default("[]") // JSON: string[]
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([taskType])
  @@index([validated])
}

// R3: Zero-Trust Federation
model FederationPeer {
  id             String    @id @default(cuid())
  name           String
  endpoint       String // wss:// or https://
  publicKey      String? // ed25519 public key for verification
  trustLevel     String    @default("untrusted") // "untrusted" | "limited" | "trusted" | "full"
  trustScore     Float     @default(0) // 0-1 composite: 0.4*success + 0.2*uptime + 0.2*threat + 0.2*integrity
  status         String    @default("disconnected") // "disconnected" | "connecting" | "connected" | "suspended" | "evicted"
  mtlsCert       String? // mTLS certificate
  lastHandshake  DateTime?
  successCount   Int       @default(0)
  errorCount     Int       @default(0)
  uptimeScore    Float     @default(0) // 0-1
  threatScore    Float     @default(0) // 0-1
  integrityScore Float     @default(0) // 0-1
  piiPolicy      String    @default("block") // "block" | "redact" | "hash" | "pass"
  complianceMode String    @default("none") // "none" | "hipaa" | "soc2" | "gdpr"
  metadata       String    @default("{}") // JSON: additional peer info
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([endpoint])
  @@index([trustLevel])
  @@index([status])
}

model FederationMessage {
  id          String   @id @default(cuid())
  peerId      String
  direction   String // "inbound" | "outbound"
  messageType String // "task_request" | "task_result" | "discovery" | "heartbeat" | "consensus"
  payload     String // JSON: message payload
  piiScanned  Boolean  @default(false)
  piiDetected String  @default("[]") // JSON: list of PII types detected
  signed      Boolean  @default(false)
  signature   String?
  createdAt   DateTime @default(now())

  @@index([peerId])
  @@index([direction])
  @@index([createdAt])
}

// R4: Encryption at Rest
model EncryptionVault {
  id           String   @id @default(cuid())
  storeName    String   @unique // e.g. "sessions", "terminals", "memory"
  algorithm    String   @default("aes-256-gcm") // Encryption algorithm
  keyDerivation String  @default("pbkdf2") // "pbkdf2" | "scrypt" | "argon2"
  isActive     Boolean  @default(false) // Encryption enabled for this store
  encryptedAt  DateTime?
  version      Int      @default(1) // Schema version for migration
  metadata     String   @default("{}") // JSON: vault metadata
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}

model EncryptedRecord {
  id          String   @id @default(cuid())
  vaultId     String
  recordType  String // "session" | "terminal" | "memory" | "secret" | "config"
  recordId    String? // Reference to the original record
  iv          String // Initialization vector (base64)
  authTag     String // GCM auth tag (base64)
  ciphertext  String // Encrypted data (base64)
  magic       String  @default("RFE1") // Magic bytes for format identification
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vaultId])
  @@index([recordType])
}

// R5: AIDefence (Prompt injection, PII, safety)
model AIDefenceEvent {
  id            String   @id @default(cuid())
  eventType     String // "prompt_injection" | "pii_detected" | "unsafe_content" | "data_exfiltration" | "command_injection" | "path_traversal"
  severity      String   @default("medium") // "low" | "medium" | "high" | "critical"
  source        String // "user_input" | "api_request" | "agent_output" | "file_upload"
  input         String // The flagged content (truncated)
  action        String // "blocked" | "redacted" | "flagged" | "allowed_with_warning"
  ruleId        String // Which rule triggered
  details       String? // JSON: detailed analysis
  agentId       String?
  sessionId     String?
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([isResolved])
}

model DefenceRule {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  ruleType    String // "prompt_injection" | "pii" | "safety" | "command_injection" | "path_traversal" | "data_exfil"
  pattern     String // Regex or detection pattern
  action      String // "block" | "redact" | "flag" | "hash"
  sensitivity String   @default("medium") // "low" | "medium" | "high" | "paranoid"
  isEnabled   Boolean  @default(true)
  falsePositives Int   @default(0)
  truePositives  Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ruleType])
  @@index([isEnabled])
}

// R6: Cost Tracker (Token budgets, cost alerts)
model CostBudget {
  id             String   @id @default(cuid())
  name           String
  scope          String // "global" | "provider" | "agent" | "project" | "user"
  scopeId        String? // Reference ID for the scope
  period         String   @default("monthly") // "daily" | "weekly" | "monthly"
  tokenLimit     Int? // Max tokens per period
  costLimit      Float? // Max cost per period
  currentTokens  Int      @default(0) // Tokens used this period
  currentCost    Float    @default(0) // Cost this period
  alertThreshold Float    @default(0.8) // Alert at 80% of limit
  isEnabled      Boolean  @default(true)
  lastResetAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([scope])
  @@index([isEnabled])
}

model CostAlert {
  id         String   @id @default(cuid())
  budgetId   String
  alertType  String // "threshold" | "limit_reached" | "anomaly" | "spike"
  message    String
  threshold  Float? // Percentage that triggered
  currentSpend Float?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([budgetId])
  @@index([isRead])
}

// R7: Goal Planner (GOAP A* decomposition)
model GoalPlan {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String   @default("planning") // "planning" | "executing" | "completed" | "failed" | "cancelled"
  goalState   String // JSON: desired end state
  currentState String @default("{}") // JSON: current state
  planTree    String  @default("[]") // JSON: { id, action, preconditions, effects, status, assignedAgent, children[] }[]
  strategy    String  @default("astar") // "astar" | "bfs" | "dfs" | "greedy"
  maxDepth    Int     @default(10)
  iterations  Int     @default(0)
  score       Float   @default(0) // Plan quality score
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  actions     GoalAction[]

  @@index([status])
}

model GoalAction {
  id          String   @id @default(cuid())
  planId      String
  name        String
  description String?
  preconditions String @default("[]") // JSON: state requirements
  effects     String  @default("[]") // JSON: state changes
  cost        Float   @default(1.0) // Action cost for A*
  status      String  @default("pending") // "pending" | "in_progress" | "completed" | "failed" | "skipped"
  assignedAgent String?
  toolMapping String? // JSON: mapping to MCP/tool call
  order       Int     @default(0)
  result      String? // JSON: action result
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plan        GoalPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

// R8: Knowledge Graph (Entity relationships)
model KnowledgeEntity {
  id          String   @id @default(cuid())
  name        String
  entityType  String // "concept" | "person" | "project" | "technology" | "domain" | "resource" | "event"
  description String?
  properties  String  @default("{}") // JSON: arbitrary properties
  embedding   String? // JSON vector for semantic search
  confidence  Float   @default(1.0) // 0-1
  sourceId    String? // Where this entity came from
  sourceType  String? // "conversation" | "document" | "agent" | "manual"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([entityType])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  sourceId     String // KnowledgeEntity id
  targetId     String // KnowledgeEntity id
  relationType String // "depends_on" | "related_to" | "part_of" | "owns" | "uses" | "produces" | "blocks" | "supports"
  properties   String  @default("{}") // JSON: relation properties
  weight       Float   @default(1.0) // 0-1 strength
  bidirectional Boolean @default(false)
  confidence   Float   @default(1.0)
  createdAt    DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
}

// R9: Background Workers (Auto-triggered)
model BackgroundWorker {
  id           String    @id @default(cuid())
  name         String
  workerType   String // "audit" | "optimize" | "testgaps" | "security_scan" | "memory_cleanup" | "cost_report" | "health_check" | "provider_benchmark" | "knowledge_index" | "agent_training" | "compliance_check" | "backup"
  description  String?
  cronExpr     String // Schedule expression
  status       String    @default("idle") // "idle" | "running" | "paused" | "error" | "disabled"
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  lastResult   String? // JSON: { success, output, duration }
  runCount     Int       @default(0)
  successCount Int       @default(0)
  errorCount   Int       @default(0)
  config       String    @default("{}") // JSON: worker-specific config
  autoTrigger  Boolean   @default(true) // Auto-trigger on schedule
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workerType])
  @@index([status])
}

// R10: Cryptographic Verification
model VerificationWitness {
  id          String   @id @default(cuid())
  filePath    String
  fileHash    String // SHA-256 hash
  algorithm   String  @default("sha256")
  signature   String? // Ed25519 signature
  publicKey   String? // Public key used for signing
  commitHash  String? // Git commit at time of signing
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([filePath])
  @@index([verified])
}

model VerificationReport {
  id           String   @id @default(cuid())
  status       String   @default("pending") // "pending" | "passed" | "failed" | "error"
  totalFiles   Int      @default(0)
  verifiedFiles Int     @default(0)
  failedFiles  Int      @default(0)
  details      String   @default("[]") // JSON: { filePath, expected, actual, match }[]
  signature    String? // Ed25519 signature of the report
  createdAt    DateTime @default(now())

  @@index([status])
}
