generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("New Chat")
  model        String    @default("gemini-2.5-pro")
  systemPrompt String?
  isFavorite   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  agentId        String?
  role           String
  content        String
  attachments    String?
  metadata       String?
  toolCalls      String?
  edited         Boolean      @default(false)
  parentId       String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique
  content   String
  source    String
  embedding String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String?
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String
  systemPrompt String
  avatar       String?
  skills       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  content     String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  content    String
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  content    String
  embedding  String?
  index      Int
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, index])
  @@index([documentId])
}

model AgentPipeline {
  id             String   @id @default(cuid())
  name           String
  description    String?
  steps          String
  status         String   @default("draft")
  currentStep    Int      @default(0)
  results        String?
  parallelGroups String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CodingSession {
  id            String   @id @default(cuid())
  title         String
  workspacePath String
  task          String
  status        String   @default("idle")
  approvalMode  String   @default("suggest")
  iterations    Int      @default(0)
  maxIterations Int      @default(10)
  plan          String?
  checkpoints   String?
  diffLog       String?
  testResults   String?
  result        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ModelRoute {
  id           String   @id @default(cuid())
  name         String
  taskType     String
  modelId      String
  priority     Int      @default(0)
  fallbackIds  String   @default("[]")
  costPerToken Float?
  avgLatency   Float?
  successRate  Float?
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CodeIndex {
  id          String   @id @default(cuid())
  projectPath String
  filePath    String
  symbolName  String
  symbolType  String
  lineStart   Int
  lineEnd     Int?
  content     String?
  embedding   String?
  updatedAt   DateTime @updatedAt
}

model SecurityVulnerability {
  id         String   @id @default(cuid())
  filePath   String
  line       Int
  severity   String
  ruleId     String
  message    String
  suggestion String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BotConnection {
  id              String    @id @default(cuid())
  platform        String
  name            String
  token           String?
  isConnected     Boolean   @default(false)
  config          String?
  botEnabled      Boolean   @default(true)
  connectedNumber String?
  personality     String?
  lastActivity    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model UIBuilderProject {
  id            String   @id @default(cuid())
  name          String
  description   String?
  framework     String   @default("react")
  components    String   @default("[]")
  generatedCode String?
  previewUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DatabaseConnection {
  id               String   @id @default(cuid())
  name             String
  type             String
  connectionString String
  schemaSnapshot   String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeployEnvironment {
  id          String    @id @default(cuid())
  name        String
  projectPath String
  type        String
  config      String
  lastDeploy  DateTime?
  deployCount Int       @default(0)
  status      String    @default("idle")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  agentId   String?
  action    String
  resource  String?
  reasoning String?
  risk      String   @default("low")
  metadata  String?
  createdAt DateTime @default(now())
}

model ExposedSecret {
  id          String   @id @default(cuid())
  filePath    String
  line        Int
  secretType  String
  maskedValue String
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  model      String?
  agentId    String?
  tokensUsed Int?
  cost       Float?
  duration   Float?
  success    Boolean?
  metadata   String?
  createdAt  DateTime @default(now())
}

model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  author      String
  version     String
  category    String
  manifest    String
  isEnabled   Boolean  @default(false)
  isInstalled Boolean  @default(false)
  rating      Float    @default(0)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GitAnalysis {
  id          String   @id @default(cuid())
  projectPath String
  commitHash  String
  analysis    String
  type        String
  createdAt   DateTime @default(now())
}

model KanbanBoard {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  columns   KanbanColumn[]
}

model KanbanColumn {
  id        String       @id @default(cuid())
  boardId   String
  name      String
  color     String       @default("#6b7280")
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  board     KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]
}

model KanbanCard {
  id          String       @id @default(cuid())
  columnId    String
  title       String
  description String?
  priority    String       @default("medium")
  labels      String       @default("[]")
  assignee    String?
  status      String       @default("backlog")
  subtasks    String       @default("[]")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
}

// Artifacts System
model Artifact {
  id          String   @id @default(cuid())
  title       String
  type        String   // "document" | "spreadsheet" | "presentation" | "report" | "markdown" | "code" | "diagram" | "canvas" | "whiteboard" | "infographic"
  content     String   // JSON or Markdown content
  metadata    String?  // JSON: { author, tags, canvas_data, version }
  version     Int      @default(1)
  isPublic    Boolean  @default(false)
  shareToken  String?  @unique
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    ArtifactVersion[]
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  version    Int
  content    String
  changeLog  String?
  createdAt  DateTime @default(now())
  artifact   Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
}

// Collaborative Workspaces
model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  artifacts   String            @default("[]") // JSON: artifact IDs
  members     String?           @default("[]") // JSON: { userId, name, color, lastSeen }
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
