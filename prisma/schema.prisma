generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conversation {
  id           String    @id @default(cuid())
  title        String    @default("New Chat")
  model        String    @default("gemini-2.5-pro")
  systemPrompt String?
  isFavorite   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  agentId        String?
  role           String // "user", "assistant", "system"
  content        String
  attachments    String? // JSON array of file references
  metadata       String? // JSON for extra info (model, tokens, etc.)
  toolCalls      String? // JSON array of tool calls
  edited         Boolean      @default(false)
  parentId       String? // For conversation branching
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id        String   @id @default(cuid())
  key       String   @unique // Memory key/topic
  content   String // Memory content/summary
  source    String // Source conversation ID or "manual"
  embedding String? // JSON array of embedding vector
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Provider {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String?
  apiKey    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Agent {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String
  systemPrompt String
  avatar       String? // Icon/Emoji representation
  skills       String? // JSON array of skill names/IDs
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  content     String
  description String?
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDocument {
  id         String           @id @default(cuid())
  title      String
  content    String
  chunkCount Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  chunks     KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  content    String
  embedding  String?
  index      Int
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([documentId])
}

// === NEW MODELS FOR 16 FEATURE ENHANCEMENTS ===

// Feature 1: Multi-Agent Orchestration
model AgentPipeline {
  id             String   @id @default(cuid())
  name           String
  description    String?
  steps          String // JSON: { agentId, order, approvalRequired, inputMapping, outputMapping }[]
  status         String   @default("draft") // "draft" | "running" | "completed" | "failed" | "paused"
  currentStep    Int      @default(0)
  results        String? // JSON: { step, output, status, duration }[]
  parallelGroups String? // JSON: [[0,1], [2]] - which steps run in parallel
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Feature 2: Autonomous Coding Loop
model CodingSession {
  id            String   @id @default(cuid())
  title         String
  workspacePath String
  task          String // The coding task description
  status        String   @default("idle") // "idle" | "planning" | "coding" | "testing" | "fixing" | "committed" | "failed"
  approvalMode  String   @default("suggest") // "auto" | "suggest" | "ask"
  iterations    Int      @default(0)
  maxIterations Int      @default(10)
  plan          String? // JSON: { steps: string[] }
  checkpoints   String? // JSON: { id, timestamp, commitHash, description }[]
  diffLog       String? // JSON: { timestamp, file, diff }[]
  testResults   String? // JSON: { passed, failed, output }[]
  result        String? // Final result summary
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Feature 3: Multi-Model Router
model ModelRoute {
  id           String   @id @default(cuid())
  name         String
  taskType     String // "code" | "analysis" | "creative" | "quick" | "reasoning" | "embedding"
  modelId      String // The model to route to
  priority     Int      @default(0) // Higher = preferred
  fallbackIds  String   @default("[]") // JSON: string[] of fallback model IDs
  costPerToken Float? // Cost tracking
  avgLatency   Float? // Average response time in ms
  successRate  Float? // 0-1 success rate
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Feature 4: Codebase Intelligence
model CodeIndex {
  id          String   @id @default(cuid())
  projectPath String
  filePath    String
  symbolName  String
  symbolType  String // "function" | "class" | "variable" | "import" | "export"
  lineStart   Int
  lineEnd     Int?
  content     String? // Snippet
  embedding   String? // JSON vector
  updatedAt   DateTime @updatedAt
}

model SecurityVulnerability {
  id         String   @id @default(cuid())
  filePath   String
  line       Int
  severity   String // "critical" | "high" | "medium" | "low" | "info"
  ruleId     String // e.g., "SQL_INJECTION", "EXPOSED_SECRET"
  message    String
  suggestion String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Feature 6: Multi-Platform Comms Hub
model BotConnection {
  id              String    @id @default(cuid())
  platform        String // "whatsapp" | "telegram" | "discord" | "slack"
  name            String
  token           String? // Bot token for Telegram/Discord/Slack
  isConnected     Boolean   @default(false)
  config          String? // JSON: platform-specific config
  botEnabled      Boolean   @default(true)
  connectedNumber String?
  personality     String? // JSON: { tone, style, rules } - channel-specific personality
  lastActivity    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Feature 7: Visual UI Builder
model UIBuilderProject {
  id            String   @id @default(cuid())
  name          String
  description   String?
  framework     String   @default("react") // "react" | "vue" | "html"
  components    String   @default("[]") // JSON: { id, type, props, children, styles }[]
  generatedCode String?
  previewUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Feature 8: Database Studio
model DatabaseConnection {
  id               String   @id @default(cuid())
  name             String
  type             String // "sqlite" | "postgresql" | "mysql" | "mongodb"
  connectionString String
  schemaSnapshot   String? // JSON: last known schema
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Feature 9: Deploy Pipeline
model DeployEnvironment {
  id          String    @id @default(cuid())
  name        String // "dev" | "staging" | "production"
  projectPath String
  type        String // "docker" | "serverless" | "vps" | "static"
  config      String // JSON: environment-specific config
  lastDeploy  DateTime?
  deployCount Int       @default(0)
  status      String    @default("idle") // "idle" | "deploying" | "running" | "failed"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Feature 10: Security Vault
model SecurityAuditLog {
  id        String   @id @default(cuid())
  agentId   String?
  action    String // What was done
  resource  String? // What was accessed
  reasoning String? // Why it was done
  risk      String   @default("low") // "low" | "medium" | "high" | "critical"
  metadata  String? // JSON: additional context
  createdAt DateTime @default(now())
}

model ExposedSecret {
  id          String   @id @default(cuid())
  filePath    String
  line        Int
  secretType  String // "api_key" | "password" | "token" | "private_key" | "connection_string"
  maskedValue String // Show first/last 2 chars only
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature 11: Analytics
model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String // "chat" | "agent_run" | "model_call" | "deploy" | "code_gen"
  model      String?
  agentId    String?
  tokensUsed Int?
  cost       Float?
  duration   Float? // ms
  success    Boolean?
  metadata   String? // JSON
  createdAt  DateTime @default(now())
}

// Feature 12: Plugin Marketplace
model Plugin {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  author      String
  version     String
  category    String // "integration" | "tool" | "agent" | "theme" | "utility"
  manifest    String // JSON: plugin manifest
  isEnabled   Boolean  @default(false)
  isInstalled Boolean  @default(false)
  rating      Float    @default(0)
  installs    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature 15: Git Intelligence
model GitAnalysis {
  id          String   @id @default(cuid())
  projectPath String
  commitHash  String
  analysis    String // JSON: { summary, risk, suggestions }
  type        String // "commit" | "pr" | "conflict" | "review"
  createdAt   DateTime @default(now())
}

// ============================================================
// NEXT-GEN ENHANCEMENT MODELS
// ============================================================

// P0-1: Universal Context Memory
model ContextMemory {
  id            String   @id @default(cuid())
  type          String // "episodic" | "semantic" | "procedural" | "project" | "agent" | "session"
  category      String // "conversation" | "code" | "workflow" | "preference" | "error" | "success" | "research"
  content       String
  summary       String? // Compressed/summarized version
  embedding     String? // JSON vector for semantic retrieval
  sourceId      String? // Origin: conversationId, agentId, sessionId, etc.
  sourceType    String? // "conversation" | "agent" | "session" | "manual"
  projectId     String? // Project association
  agentId       String? // Agent association
  tags          String   @default("[]") // JSON: string[]
  priority      Int      @default(0) // Higher = more important
  accessCount   Int      @default(0) // How many times retrieved
  relevanceScore Float? // Computed relevance
  expiresAt     DateTime? // Optional TTL for aging
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([projectId])
  @@index([agentId])
  @@index([priority])
}

model MemoryLink {
  id           String   @id @default(cuid())
  sourceId     String // ContextMemory id
  targetId     String // ContextMemory id
  relationType String // "continuation" | "reference" | "contradiction" | "refinement" | "derived"
  strength     Float   @default(1.0) // 0-1 link strength
  createdAt    DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
}

// P0-2: Cron Scheduling + Always-On Agents
model CronTask {
  id            String    @id @default(cuid())
  name          String
  description   String?
  cronExpr      String // e.g. "*/5 * * * *"
  taskType      String // "agent_run" | "repo_monitor" | "health_check" | "auto_deploy" | "issue_resolve" | "custom"
  agentId       String?
  config        String // JSON: task-specific config
  status        String    @default("active") // "active" | "paused" | "disabled" | "error"
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastResult    String? // JSON: { success, output, duration }
  runCount      Int       @default(0)
  failCount     Int       @default(0)
  retryPolicy   String    @default("{}") // JSON: { maxRetries, backoffMs }
  dependencies  String    @default("[]") // JSON: task IDs that must complete first
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([taskType])
}

model AgentWorker {
  id            String    @id @default(cuid())
  name          String
  agentId       String // Reference to Agent
  status        String    @default("idle") // "idle" | "running" | "waiting" | "error" | "stopped"
  currentTask   String? // Description of current task
  pid           Int? // Process ID if running
  lastHeartbeat DateTime?
  totalTasks    Int       @default(0)
  successCount  Int       @default(0)
  errorCount    Int       @default(0)
  config        String    @default("{}") // JSON: worker config
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// P1-1: Self-Improving Agents
model AgentExperience {
  id             String   @id @default(cuid())
  agentId        String
  taskType       String // "code_gen" | "debug" | "review" | "deploy" | "research" | "general"
  prompt         String // The prompt that was used
  strategy       String // Which strategy/model was chosen
  outcome        String // "success" | "partial" | "failure"
  score          Float // 0-1 quality score
  duration       Float? // ms
  tokensUsed     Int?
  resultSnippet  String? // First 500 chars of result
  learnings      String? // JSON: extracted patterns
  improvedPrompt String? // Optimized prompt based on this experience
  createdAt      DateTime @default(now())

  @@index([agentId])
  @@index([taskType])
  @@index([outcome])
  @@index([score])
}

model PromptTemplate {
  id          String   @id @default(cuid())
  taskType    String
  agentRole   String?
  template    String
  version     Int      @default(1)
  score       Float    @default(0)
  usageCount  Int      @default(0)
  successRate Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([taskType])
  @@index([agentRole])
}

// P1-2: Research Mode + Citations
model ResearchSession {
  id            String   @id @default(cuid())
  query         String
  status        String   @default("searching") // "searching" | "analyzing" | "synthesizing" | "completed" | "failed"
  sources       String   @default("[]") // JSON: { url, title, snippet, credibility, type }[]
  citations     String   @default("[]") // JSON: { id, sourceId, text, relevance }[]
  findings      String? // Markdown synthesis
  confidence    Float? // 0-1 overall confidence
  depth         String   @default("standard") // "quick" | "standard" | "deep"
  model         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Citation {
  id              String   @id @default(cuid())
  researchId      String
  sourceUrl       String?
  sourceTitle     String
  sourceType      String // "web" | "code" | "doc" | "paper" | "repo"
  snippet         String
  relevanceScore  Float    @default(0)
  credibility     Float    @default(0)
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([researchId])
  @@index([sourceType])
}

// P1-3: Issue → Deploy Pipeline
model IssuePipeline {
  id            String    @id @default(cuid())
  issueUrl      String? // GitHub issue URL
  issueTitle    String
  issueBody     String?
  repoUrl       String?
  status        String    @default("planning") // "planning" | "coding" | "testing" | "reviewing" | "pr_created" | "deployed" | "failed"
  plan          String? // JSON: { steps }
  branchName    String?
  prUrl         String?
  prNumber      Int?
  deployUrl     String?
  testResults   String? // JSON
  reviewNotes   String?
  iterations    Int       @default(0)
  maxIterations Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

// P2-1: Live App Sandbox
model Sandbox {
  id           String    @id @default(cuid())
  name         String
  framework    String    @default("nextjs") // "nextjs" | "react" | "html" | "vue"
  status       String    @default("creating") // "creating" | "running" | "stopped" | "error"
  port         Int?
  containerId  String?
  previewUrl   String?
  files        String    @default("{}") // JSON: { path: content }
  envVars      String    @default("{}") // JSON: { key: value }
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// P2-2: MCP Hub
model MCPRegistry {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String
  version      String
  author       String
  transport    String // "stdio" | "http" | "websocket"
  endpoint     String? // URL for remote servers
  capabilities String   @default("[]") // JSON: string[]
  authType     String? // "none" | "api_key" | "oauth"
  authConfig   String? // JSON: auth details
  isEnabled    Boolean  @default(false)
  isVerified   Boolean  @default(false)
  rating       Float    @default(0)
  installs     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isEnabled])
}

// P2-3: Hybrid Local ↔ Cloud Router
model ProviderScore {
  id              String   @id @default(cuid())
  providerName    String
  modelId         String
  taskType        String // "code" | "analysis" | "creative" | "reasoning" | "embedding" | "chat"
  avgLatency      Float    @default(0) // ms
  avgTokensPerSec Float    @default(0)
  successRate     Float    @default(0) // 0-1
  costPer1kTokens Float    @default(0)
  contextLength   Int      @default(0)
  qualityScore    Float    @default(0) // 0-1 from evaluations
  privacyLevel    String   @default("cloud") // "local" | "hybrid" | "cloud"
  lastEvaluated   DateTime @default(now())
  sampleSize      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerName, modelId, taskType])
  @@index([taskType])
  @@index([providerName])
}

// P3-1: Verified Plugin Marketplace V2
model VerifiedPlugin {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String
  author         String
  version        String
  category       String // "integration" | "tool" | "agent" | "theme" | "utility" | "mcp"
  manifest       String // JSON: full manifest
  signature      String? // Cryptographic signature
  checksum       String? // Content hash for verification
  permissions    String   @default("[]") // JSON: requested permissions
  sandboxLevel   String   @default("restricted") // "full" | "restricted" | "minimal"
  isEnabled      Boolean  @default(false)
  isInstalled    Boolean  @default(false)
  isVerified     Boolean  @default(false)
  securityScan   String? // JSON: { passed, issues[] }
  rating         Float    @default(0)
  installs       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([isVerified])
}

// P3-2: Real-Time Collaboration
model CollabSession {
  id          String   @id @default(cuid())
  name        String
  hostId      String // User ID of session host
  peers       String   @default("[]") // JSON: { id, name, cursor, color }[]
  status      String   @default("active") // "active" | "ended"
  sharedAgent String? // Agent ID shared in session
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// P3-4: Compliance Engine
model AuditLog {
  id          String   @id @default(cuid())
  actor       String // User/agent who performed action
  action      String // What was done
  resource    String // What was accessed
  result      String // "success" | "denied" | "error"
  risk        String   @default("low") // "low" | "medium" | "high" | "critical"
  details     String? // JSON: additional context
  ipAddress   String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([risk])
  @@index([createdAt])
}

model CompliancePolicy {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  ruleType    String // "rbac" | "data_access" | "secret_scan" | "gdpr" | "soc2" | "custom"
  config      String // JSON: rule configuration
  severity    String   @default("medium") // "low" | "medium" | "high" | "critical"
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ruleType])
  @@index([isEnabled])
}

// Feature: Artifacts
model Artifact {
  id         String           @id @default(cuid())
  title      String
  type       String
  content    String           @default("")
  metadata   String?
  version    Int              @default(1)
  shareToken String?
  isPublic   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  versions   ArtifactVersion[]
}

model ArtifactVersion {
  id        String   @id @default(cuid())
  artifactId String
  version   Int
  content   String
  changeLog String?
  createdAt DateTime @default(now())
  artifact  Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([artifactId])
}

// Feature: Workspaces
model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Feature: Kanban Boards
model KanbanBoard {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  columns   KanbanColumn[]
}

model KanbanColumn {
  id        String      @id @default(cuid())
  boardId   String
  name      String
  color     String
  order     Int
  createdAt DateTime    @default(now())
  board     KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]

  @@index([boardId])
}

model KanbanCard {
  id          String       @id @default(cuid())
  columnId    String
  title       String
  description String?
  priority    String?
  labels      String? // JSON: string[]
  status      String?
  subtasks    String? // JSON: { title: string; done: boolean }[]
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
}
